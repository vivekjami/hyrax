# Hyrax environment configuration
# Copy to .env and edit as needed. Never commit .env to git.

# ── Hyrax listener ──────────────────────────────────────────────────────────
HYRAX_PORT=5050
HYRAX_HOST=0.0.0.0
LOG_LEVEL=INFO

# Enable to print every span to stdout (dev only)
HYRAX_DEBUG_SPANS=false

# ── OTLP export ─────────────────────────────────────────────────────────────
# SigNoz default (otel-collector gRPC)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true

# Batching
HYRAX_BATCH_SIZE=64
HYRAX_EXPORT_TIMEOUT_MS=10000

# ── Metrics ─────────────────────────────────────────────────────────────────
# How often to push metrics (milliseconds)
HYRAX_METRIC_INTERVAL_MS=15000
